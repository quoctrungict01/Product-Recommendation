# Mẫu cấu hình backend. Sao chép thành .env rồi điền giá trị thật.
# KHÔNG commit file .env. File này chỉ chứa tên biến và giá trị mẫu.

SERVER_PORT=8000
PREFIX_API_VERSION=/api/v1

# MongoDB (bắt buộc). Demo dùng database GR2 trên máy cục bộ.
DB_URI=mongodb://127.0.0.1:27017/GR2

# Khóa ký JWT (bắt buộc, tối thiểu 32 ký tự, ngẫu nhiên). Tạo bằng lệnh sau (ghi thẳng vào .env, không in ra màn hình):
#   node -e "require('fs').appendFileSync('.env','JWT_SECRET='+require('crypto').randomBytes(48).toString('hex')+'\n')"
JWT_SECRET=replace_with_random_secret_at_least_32_chars

# Email (tùy chọn). Để trống MAIL_USER và MAIL_PASS thì chức năng email bị tắt.
# Với Gmail, MAIL_PASS là "App password" tạo trong tài khoản Google, không phải mật khẩu đăng nhập.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=

# CORS (tùy chọn): các origin trình duyệt được gọi API, phân tách bằng dấu phẩy.
# Bỏ trống -> mặc định http://localhost:3000, http://localhost:3001 (và 127.0.0.1 tương ứng).
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001
